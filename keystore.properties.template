# Release signing config for the APK on the GitHub release (which F-Droid also ships,
# after checking that its own build of the source matches it byte for byte).
#
# 1. Generate a release keystore ONCE and keep it somewhere safe & backed up
#    (losing it means no existing install — GitHub, Obtainium or F-Droid — can ever
#    be updated again):
#
#      keytool -genkeypair -v \
#        -keystore astroloop-release.jks \
#        -alias astroloop -keyalg RSA -keysize 4096 -validity 10000
#
# 2. Copy this file to  keystore.properties  (which is gitignored) and fill in
#    the real values. Use an ABSOLUTE path for storeFile.
#
# F-Droid's build server never has this file: it builds unsigned and compares.

storeFile=/absolute/path/to/astroloop-release.jks
storePassword=CHANGEME
keyAlias=astroloop
keyPassword=CHANGEME
